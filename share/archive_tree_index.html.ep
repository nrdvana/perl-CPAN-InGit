<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= $tree_name %> — CPAN index</title>
  <style>
    body { font: 1rem/1.5 system-ui, sans-serif; max-width: 80rem; margin: 2rem auto; padding: 0 1rem; color: #172331; }
    h1 { margin-bottom: .5rem; }
    dt { font-weight: 600; } dd { margin: 0 0 .5rem; }
    input { font: inherit; padding: .5rem; width: min(30rem, 90%); }
    button { font: inherit; padding: .5rem 1rem; cursor: pointer; }
    .table-scroll { overflow-x: auto; margin-bottom: 1rem; }
    table { border-collapse: collapse; width: 100%; text-align: left; }
    th, td { border-bottom: 1px solid #d9e0e6; padding: .5rem; }
    th { background: #eef2f6; } a { color: #165ca2; }
  </style>
  <script src="<%= $script_url %>" defer></script>
</head>
<body>
  <main id="cpan-index" data-json-url="<%= $json_url %>" data-authors-url="<%= $authors_url %>"
      data-filter="<%= $module_page->{filter} %>" data-tree="<%= $module_page->{tree} %>"
      data-complete="<%= $module_page->{complete}? 'true' : 'false' %>"
      data-next-after="<%= $module_page->{next_after} // '' %>"
      data-previous-before="<%= $module_page->{previous_before} // '' %>">
    <h1><%= $tree_name %></h1>
    <dl>
      <dt>Commit date</dt><dd id="commit-date"><%= $commit_date // 'Unavailable for this tree' %></dd>
      <dt>02packages.details.txt updated</dt><dd id="index-updated"><%= $index_updated // 'Unknown' %></dd>
    </dl>
    <form method="get" id="module-filter-form">
      <label for="module-filter">Filter modules, versions, or distribution paths</label><br>
      <input id="module-filter" name="filter" type="search" value="<%= $module_page->{filter} %>" autocomplete="off" aria-describedby="filter-help">
      <noscript><button type="submit">Filter</button></noscript>
    </form>
    <p id="filter-help">Case-insensitive text search across each package row.</p>
    <p id="module-status" role="status" aria-live="polite">
      Showing <%= scalar $module_page->{modules}->@* %> modules<%= $module_page->{complete}? ' (all matches).' : '.' %>
    </p>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">Module</th><th scope="col">Version</th><th scope="col">Distribution</th></tr></thead>
        <tbody id="module-rows">
% for my $row ($module_page->{modules}->@*) {
          <tr data-row="<%= JSON::PP->new->encode($row) %>">
            <td><%= $row->{name} %></td><td><%= $row->{version} %></td>
            <td><a href="<%= $authors_url %><%= join '/', map Mojo::Util::url_escape($_), split '/', $row->{path} %>"><%= $row->{path} %></a></td>
          </tr>
% }
        </tbody>
      </table>
    </div>
    <button id="load-more" type="button" <%= $module_page->{next_after}? '' : 'hidden' %>>Load more</button>
    <noscript><p>Enable JavaScript to load more modules without reloading.</p></noscript>
  </main>
</body>
</html>
